# Cache rules for hosts that read a _headers file (Netlify, Cloudflare Pages).
# Built assets carry a content hash in their names, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs, video and logos keep stable names; cache them for 30 days.
/media/*
  Cache-Control: public, max-age=2592000
